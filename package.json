{
  "name": "cheetah-broadband-support",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:unit": "DATABASE_URL=file:./dev.db pnpm db:generate && DATABASE_URL=file:./dev.db pnpm db:push && DATABASE_URL=file:./dev.db jest --config jest.config.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^15.5.3",
    "postcss": "^8.5.30",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
